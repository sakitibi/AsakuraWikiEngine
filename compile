#!/bin/bash

# エラーが発生したら即座に終了
set -e

PROJECT_PATH="src/compiler/compiler.csproj"
CONFIGURATION="Release"

echo "=== Building WikiCompiler for All Platforms ==="

rm -fr src/compiler/obj
rm -fr src/compiler/bin

# 1. Windows (x64)
echo "[1/4] Building for Windows (x64)..."
dotnet publish "$PROJECT_PATH" -c $CONFIGURATION -r win-x64 --self-contained true /p:PublishSingleFile=true

# 2. macOS (Apple Silicon: arm64)
echo "[2/4] Building for macOS (Apple Silicon - arm64)..."
dotnet publish "$PROJECT_PATH" -c $CONFIGURATION -r osx-arm64 --self-contained true /p:PublishSingleFile=true

# 3. macOS (Intel: x64)
echo "[3/4] Building for macOS (Intel - x64)..."
dotnet publish "$PROJECT_PATH" -c $CONFIGURATION -r osx-x64 --self-contained true /p:PublishSingleFile=true

# 4. Linux (x64)
echo "[4/4] Building for Linux (x64)..."
dotnet publish "$PROJECT_PATH" -c $CONFIGURATION -r linux-x64 --self-contained true /p:PublishSingleFile=true

echo "=== All builds completed successfully! ==="
echo "Binaries are located in: src/compiler/bin/Release/netX.X/ [target]/publish/"